{
    "name": "ureche-backend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --import tsx --watch src/index.ts",
        "build": "tsc",
        "db:seed": "docker cp seed.sql fichajes_postgres:/tmp/seed.sql && docker exec fichajes_postgres psql -U postgres -d fichajes_db -f /tmp/seed.sql"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.3.1",
        "@types/pg": "^8.15.5",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.2"
    }
}
